# Nashr environment template. Copy to `.env` and fill in.
# `docker compose --env-file .env up -d` picks the file up automatically.

# === Required ===
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Claude transport: vertex (default, bills via GCP) or anthropic (direct API fallback).
LLM_TRANSPORT=vertex
GEMINI_API_KEY=AIza...
# Explicit Gemini context cache for the Way 2 brain block (5B-Q5b). Code default is OFF;
# docker-compose defaults it ON for the production host. 0 disables.
GEMINI_BRAIN_CACHE=1

# === Gemini routing (optional — recommended for non-trivial workloads) ===
# Set VERTEX_PROJECT to your GCP project ID to route Gemini calls through
# Vertex AI instead of AI Studio. Vertex bills against your GCP project
# and bypasses the AI Studio prepayment-credit pool. Auth resolves via
# `gcloud auth application-default login` (ADC) or
# GOOGLE_APPLICATION_CREDENTIALS, in that order.
VERTEX_PROJECT=
# `global` is the location that publishes the Gemini 3.x family on Vertex;
# regional endpoints (e.g. us-central1) currently return 404 for 3.x.
VERTEX_LOCATION=global

# === Web API (packages/api — the FastAPI backend behind Caddy) ===
# Public hostname Caddy provisions TLS for and reverse-proxies to the api
# container. Point this domain's A record at the VM before first deploy.
# (The API's internal port is fixed at 8090 in compose — not a knob.)
API_DOMAIN=api.nashr.com.uz
# Supabase anon (publishable) key + the project's LEGACY shared JWT secret
# (Dashboard -> Settings -> API). The JWT secret mints Path A session tokens;
# empty ⇒ the auth surface refuses to mint (fails closed) rather than issuing
# unverifiable tokens.
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
APP_JWT_TTL_SECONDS=3600
# Comma-separated CORS allowlist for the web app origins (no wildcard).
WEB_CORS_ORIGINS=https://nashr.com.uz,https://www.nashr.com.uz

# === Deployment ===
NASHR_ENV=production
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PORT=8080
MINI_APP_BASE_URL=https://your-domain.com

# === Admin (comma-separated Telegram user IDs) ===
NASHR_ADMIN_IDS=

# === Cloudflare R2 (optional for dev; files land in ~/.nashr/storage when blank) ===
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=nashr-files

# === Payment providers (fill in when merchant accounts are ready) ===
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=

# === Redis (compose service hostname; override to point at managed Redis) ===
REDIS_URL=redis://redis:6379
