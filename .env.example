# Nashr environment template. Copy to `.env` and fill in.
# `docker compose --env-file .env up -d` picks the file up automatically.

# === Required ===
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# === Deployment ===
NASHR_ENV=production
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PORT=8080
MINI_APP_BASE_URL=https://your-domain.com

# === Admin (comma-separated Telegram user IDs) ===
NASHR_ADMIN_IDS=

# === Cloudflare R2 (optional for dev; files land in ~/.nashr/storage when blank) ===
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=nashr-files

# === Payment providers (fill in when merchant accounts are ready) ===
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=

# === Redis (compose service hostname; override to point at managed Redis) ===
REDIS_URL=redis://redis:6379
