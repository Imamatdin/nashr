{
  "schema": "baseline (migrations 001-015 + 016 as reviewed, blob e2863406)",
  "module": "tests/db/test_b1_fix_regressions.py",
  "tests": {
    "test_a_worker_whose_job_was_reclaimed_writes_nothing": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bObjectNotInPrerequisiteStateError\\b"
    },
    "test_a_worker_whose_claim_expired_writes_nothing": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bObjectNotInPrerequisiteStateError\\b"
    },
    "test_a_reclaim_racing_a_finish_leaves_nothing_from_the_old_claim": {
      "expect": "fail",
      "match": "AssertionError: a revision was written by a reclaimed worker"
    },
    "test_a_status_change_during_finish_never_leaves_a_revision_beside_a_failed_job": {
      "expect": "fail",
      "match": "AssertionError: a revision was written beside a failed job"
    },
    "test_a_fault_inside_finish_rolls_back_the_revision": {
      "expect": "fail",
      "match": "AssertionError: a revision survived a failed completion"
    },
    "test_a_render_job_cannot_be_created_with_a_null_target": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bCheckViolationError\\b"
    },
    "test_a_job_whose_payload_has_no_target_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_legacy_render_job_with_a_json_null_target_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_render_job_of_another_user_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_job_without_a_claim_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bObjectNotInPrerequisiteStateError\\b"
    },
    "test_a_job_of_another_type_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_format_the_job_did_not_request_cannot_be_registered": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_renderer_version_the_job_did_not_request_cannot_be_registered": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bInsufficientPrivilegeError\\b"
    },
    "test_a_stale_claim_token_cannot_register": {
      "expect": "fail",
      "match": "DID NOT RAISE .*\\bObjectNotInPrerequisiteStateError\\b"
    },
    "test_rendering_a_revision_twice_keeps_the_first_export": {
      "expect": "fail",
      "match": "UniqueViolationError: export_conflict"
    },
    "test_a_recovery_render_after_a_crash_mid_publish_completes_the_set": {
      "expect": "fail",
      "match": "UniqueViolationError: export_conflict"
    }
  }
}
