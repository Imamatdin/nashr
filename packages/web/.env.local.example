NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NOTE: the code reads NEXT_PUBLIC_API_BASE_URL (not NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_BASE_URL=https://api.nashr.com.uz
